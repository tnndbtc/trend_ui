# Crawler API Base URL
# Point this to your running crawler service

# Through nginx gateway (RECOMMENDED - works locally and from internet):
NEXT_PUBLIC_CRAWLER_API_BASE_URL=/api/v1

# Direct access (only works on local network):
# NEXT_PUBLIC_CRAWLER_API_BASE_URL=http://192.168.86.41:8002/api/v1

# Production with domain:
# NEXT_PUBLIC_CRAWLER_API_BASE_URL=https://your-domain.com/api/v1
