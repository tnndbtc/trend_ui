# Crawler API Base URL
# Point this to your running crawler service

# Through nginx gateway (RECOMMENDED - works locally and from internet):
NEXT_PUBLIC_CRAWLER_API_BASE_URL=/api/v1

# Direct access (only works on local network):
# NEXT_PUBLIC_CRAWLER_API_BASE_URL=http://192.168.86.41:8002/api/v1

# Production with domain:
# NEXT_PUBLIC_CRAWLER_API_BASE_URL=https://your-domain.com/api/v1

# ---------------------------------------------------------------------------
# Monitor status API (Services tab)
# See ~/data/code/monitor/API.md on this machine for the full contract.
# Server-side only — read in a Next.js route handler, never exposed to the
# browser (do NOT prefix any of these with NEXT_PUBLIC_).
# ---------------------------------------------------------------------------

# Base URL of the monitor service. Placeholder here on purpose — this file
# is checked into git; put the real LAN address in your local .env (not
# committed). Currently: https://192.168.86.49:3003
MONITOR_API_BASE_URL=https://<monitor-host>:3003

# The monitor's TLS cert is self-signed (same cert as search). Set to "true"
# to skip certificate verification for calls to MONITOR_API_BASE_URL only
# (matches API.md's own "curl -k / verify=False" guidance for this LAN-only
# service). Set to "false" once a trusted CA/cert is wired up instead.
# (This is about TLS trust, not authentication.)
MONITOR_API_INSECURE_TLS=true

# Auth is currently OFF on the monitor service (JWT_SECRET is empty in its
# .env — confirmed via API.md and a live call), so no token var is needed
# here today. If auth is ever turned back on: mint a token on alma4 via
# ~/data/code/monitor/setup.sh (option 8), then set MONITOR_API_TOKEN in
# your local .env — the route handler already reads it and sends
# `Authorization: Bearer <token>` automatically, no code change needed.
